generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  USER
  GUEST
}

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(190)
  passwordHash String   @db.VarChar(100)
  role         Role     @default(GUEST)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

/// Prefixos de clientes (IPv4/CIDR). Servem para dar nome ao alvo de um ataque,
/// definir limiares próprios e marcar exceções (ignore = nunca alertar).
model Prefix {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(120)
  cidr        String   @unique @db.VarChar(18)
  ignore      Boolean  @default(false)
  /// Limiares próprios (vazio = usa o padrão global). bps, pps e SYN pps.
  bpsLimit    Float?
  ppsLimit    Float?
  synPpsLimit Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("prefixes")
}

enum AttackStatus {
  OPEN
  CLOSED
}

/// Ataque detectado contra um IP de destino (um registro por ocorrência).
model AttackEvent {
  id         Int          @id @default(autoincrement())
  targetIp   String       @db.VarChar(45)
  prefixName String?      @db.VarChar(120)
  type       String       @db.VarChar(32)
  status     AttackStatus @default(OPEN)
  startedAt  DateTime     @default(now())
  lastSeenAt DateTime     @default(now())
  endedAt    DateTime?
  peakBps    Float        @default(0)
  peakPps    Float        @default(0)
  evidence   Json?
  alertedAt  DateTime?
  alertError String?      @db.VarChar(255)

  @@index([status, startedAt])
  @@index([targetIp, startedAt])
  @@map("attack_events")
}

// ---------------------------------------------------------------------------
// Tabelas escritas pelo pmacct (nfacctd). Os nomes das colunas seguem as
// convenções do plugin SQL (ip_dst, iface_in, peer_ip_src...), por isso ficam
// aqui só para o Prisma não tentar removê-las; o app apenas LÊ estes dados.
// Cada linha é um "balde" de 1 minuto, já normalizado pela taxa de amostragem.
// ---------------------------------------------------------------------------

/// Tráfego agregado por exportador, interface de entrada, destino, protocolo e flags TCP.
model FlowDst {
  peerIpSrc     String    @map("peer_ip_src") @db.Char(45)
  ifaceIn       Int       @map("iface_in") @db.UnsignedInt
  ipDst         String    @map("ip_dst") @db.Char(45)
  ipProto       String    @map("ip_proto") @db.Char(6)
  tcpFlags      Int       @map("tcp_flags") @db.UnsignedInt
  packets       Int       @db.UnsignedInt
  bytes         BigInt    @db.UnsignedBigInt
  flows         Int       @db.UnsignedInt
  stampInserted DateTime  @map("stamp_inserted") @db.DateTime(0)
  stampUpdated  DateTime? @map("stamp_updated") @db.DateTime(0)

  // O tempo vem PRIMEIRO na chave: ler "os últimos minutos" vira uma varredura
  // sequencial da tabela (sem busca aleatória por linha). Era ~2000x mais lento.
  @@id([stampInserted, peerIpSrc, ifaceIn, ipDst, ipProto, tcpFlags])
  @@index([ipDst, stampInserted])
  @@map("flow_dst")
}

/// Tráfego agregado por protocolo e porta de ORIGEM (assinaturas de amplificação).
/// Totais por minuto (todas as interfaces), gravados pelo detector a partir das
/// linhas que ele já lê. O gráfico do painel usa esta tabela: somar 60 min de
/// flow_dst custa minutos em bancos grandes.
model TrafficMinute {
  stamp   DateTime @id @db.DateTime(0)
  bytes   BigInt   @db.UnsignedBigInt
  packets BigInt   @db.UnsignedBigInt

  @@map("traffic_minute")
}

model FlowSrcPort {
  peerIpSrc     String    @map("peer_ip_src") @db.Char(45)
  ifaceIn       Int       @map("iface_in") @db.UnsignedInt
  ipProto       String    @map("ip_proto") @db.Char(6)
  portSrc       Int       @map("port_src") @db.UnsignedInt
  packets       Int       @db.UnsignedInt
  bytes         BigInt    @db.UnsignedBigInt
  flows         Int       @db.UnsignedInt
  stampInserted DateTime  @map("stamp_inserted") @db.DateTime(0)
  stampUpdated  DateTime? @map("stamp_updated") @db.DateTime(0)

  @@id([stampInserted, peerIpSrc, ifaceIn, ipProto, portSrc])
  @@map("flow_src_port")
}

model Setting {
  key       String   @id @db.VarChar(64)
  value     String   @db.VarChar(255)
  updatedAt DateTime @updatedAt

  @@map("settings")
}
