# ---------------------------------------------------------------------------
# Copie para .env e preencha. Nunca versione o .env.
# Use senhas SEM os caracteres  | & \ @ : / ? #  (ex.: openssl rand -hex 16),
# pois elas entram na URL do banco e na configuracao do coletor.
# ---------------------------------------------------------------------------

# --- Producao (docker-compose.prod.yml) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=sosisp
MYSQL_USER=sosisp
MYSQL_PASSWORD=

# Segredo da sessao (>= 32 caracteres): openssl rand -hex 32
SESSION_SECRET=

# Administrador inicial (criado na 1a subida, se o e-mail nao existir)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# true exige HTTPS no login (recomendado). false so para testar por HTTP puro.
SESSION_COOKIE_SECURE=true

# Onde o app escuta no host (use um proxy reverso/Dokploy na frente)
APP_BIND=127.0.0.1
APP_PORT=3000
# Porta UDP do coletor NetFlow
NETFLOW_PORT=2055

# --- Desenvolvimento local (npm run dev) ---
# DATABASE_URL="mysql://sosisp:sosisp123@127.0.0.1:3307/sosisp"
# SEED_DEMO=true   # cria admin/usuario/convidado @sosisp.local de demonstracao
